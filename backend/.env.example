PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string (include the db name /ringfix, no <> brackets)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ringfix?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Frontend origin(s), comma-separated. Production: your frontend Vercel URL
CLIENT_URL=http://localhost:5173

# Cloudinary (Dashboard -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ringfix
# Per-file limits in MB. Keep <= 4 on Vercel (4.5 MB request body cap)
MAX_IMAGE_MB=4
MAX_VIDEO_MB=4

# Vercel Cron auth for /api/cron/sla (any long random string)
CRON_SECRET=

# Optional SMTP (leave blank to log emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RingFix <no-reply@ringfix.local>
# Local-only SLA scan frequency (node-cron)
SLA_CRON=*/15 * * * *
